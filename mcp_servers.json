{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<1.0",
        "mcp-server-fetch"
      ]
    }
  }
}